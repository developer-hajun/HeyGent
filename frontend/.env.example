# Backend API base URL (e.g. http://localhost:8080)
VITE_API_BASE_URL=http://localhost:8080

# AI REST API direct connection URL
VITE_AI_API_BASE_URL=http://localhost:8000/ai/api/v1

# AI WebSocket direct connection URL
VITE_AI_WS_BASE_URL=ws://localhost:8000/ai/api/v1/realtime/user/ws

# Kakao OAuth
VITE_KAKAO_CLIENT_ID=your_kakao_rest_api_key
VITE_KAKAO_REDIRECT_URI=http://localhost:5173/auth/kakao/callback

# 개발용 테스트 로그인 후 자동 등록할 OpenAI API key
VITE_DEV_OPENAI_API_KEY=
