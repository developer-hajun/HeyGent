# HeyGent AI Backbone example environment
HEYGENT_APP_NAME=HeyGent AI Backbone
HEYGENT_API_PREFIX=/api/v1
HEYGENT_HOST=127.0.0.1
HEYGENT_PORT=8000
HEYGENT_RELOAD=true
HEYGENT_LOG_LEVEL=info
HEYGENT_AI_DB_PATH=tmp/app.db
# CLI remote-first default target
HEYGENT_API_BASE_URL=http://127.0.0.1:8000/api/v1

# OpenAI OAuth skeleton for model provider
HEYGENT_OPENAI_OAUTH_CLIENT_ID=
HEYGENT_OPENAI_OAUTH_CLIENT_SECRET=
HEYGENT_OPENAI_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/v1/providers/openai_oauth/callback
HEYGENT_OPENAI_OAUTH_AUTHORIZE_URL=
HEYGENT_OPENAI_OAUTH_TOKEN_URL=
HEYGENT_OPENAI_OAUTH_SCOPES=model.request,model.generate

# External integration smoke-test settings
HEYGENT_NOTION_API_BASE_URL=https://api.notion.com/v1
