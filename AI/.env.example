HEYGENT_HOST=127.0.0.1
HEYGENT_PORT=8000
HEYGENT_API_PREFIX=/api/v1
HEYGENT_AI_DB_PATH=tmp/app.db
HEYGENT_API_BASE_URL=http://127.0.0.1:8000/api/v1

# OAuth client configuration.
# Fill these with the authorization server values for the OpenAI OAuth app you are using.
HEYGENT_OPENAI_OAUTH_CLIENT_ID=
HEYGENT_OPENAI_OAUTH_CLIENT_SECRET=
HEYGENT_OPENAI_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/v1/providers/openai_oauth/callback
HEYGENT_OPENAI_OAUTH_AUTHORIZE_URL=
HEYGENT_OPENAI_OAUTH_TOKEN_URL=
HEYGENT_OPENAI_OAUTH_SCOPES=

# Optional: reuse a local Codex/ChatGPT login before falling back to browser OAuth.
HEYGENT_OPENAI_AUTH_FILE=C:\\Users\\SSAFY\\.codex\\auth.json

# Model call configuration after OAuth token storage.
HEYGENT_OPENAI_API_BASE_URL=https://api.openai.com/v1
HEYGENT_OPENAI_RESPONSE_MODEL=gpt-5.4

HEYGENT_NOTION_API_BASE_URL=https://api.notion.com/v1
