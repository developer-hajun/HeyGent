HEYGENT_HOST=127.0.0.1
HEYGENT_PORT=8000
HEYGENT_API_PREFIX=/api/v1
HEYGENT_AI_DB_PATH=tmp/app.db
HEYGENT_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Default to the same localhost callback flow OpenClaw uses. Later you can override only the redirect URL in .env.
HEYGENT_OPENAI_OAUTH_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann
HEYGENT_OPENAI_OAUTH_REDIRECT_URI=http://localhost:1455/auth/callback
HEYGENT_OPENAI_OAUTH_AUTHORIZE_URL=https://auth.openai.com/oauth/authorize
HEYGENT_OPENAI_OAUTH_TOKEN_URL=https://auth.openai.com/oauth/token
HEYGENT_OPENAI_OAUTH_SCOPES=openid,profile,email,offline_access

# Model call configuration after OAuth token storage.
HEYGENT_OPENAI_API_BASE_URL=https://chatgpt.com/backend-api
HEYGENT_OPENAI_RESPONSE_MODEL=gpt-5.4

HEYGENT_NOTION_API_BASE_URL=https://api.notion.com/v1
