# 브릿지 환경 (local|prod). GUI 에서도 라디오로 바꿀 수 있다. 기본은 prod.
BRIDGE_ENVIRONMENT=local

# 환경 프리셋을 덮어쓰고 싶을 때만 명시. 비워두면 BRIDGE_ENVIRONMENT 의 프리셋이 적용된다.
# 예: BRIDGE_AI_WS_URL=ws://localhost:8000/ai/api/v1/internal/bridge/ws
# 예: BRIDGE_AI_WS_URL=wss://k14e105.p.ssafy.io/ai/api/v1/internal/bridge/ws
BRIDGE_AI_WS_URL=
# 예: BRIDGE_API_BASE_URL=http://localhost:8080
BRIDGE_API_BASE_URL=

# 페어링으로 받은 토큰이 AppData 에 저장되지 않은 PoC 단계에서만 사용. 보통 비워둔다.
# 평소에는 GUI 페어링이 끝나면 %LOCALAPPDATA%\HeyGent\bridge.json 에 자동 저장된다.
BRIDGE_TOKEN=

# 브릿지가 다룰 사용자 PC 폴더 경계(절대 경로). terminal/file 도구 cwd 로 사용.
# 본인 PC 사용자명으로 바꿔주세요. 예: C:\Users\SSAFY\Desktop\poc-workspace
BRIDGE_WORKSPACE_ROOT=C:\Users\YOUR_USER\Desktop\poc-workspace

# heartbeat (WebSocket 프로토콜 레벨 ping). docker NAT 1분 idle 끊김 회피용 핵심 옵션.
BRIDGE_PING_INTERVAL_SECONDS=20

# 연결 끊겼을 때 재연결까지 대기 시간(초).
BRIDGE_RECONNECT_DELAY_SECONDS=3
