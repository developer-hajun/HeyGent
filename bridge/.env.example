# AI 서버 WebSocket 주소. 호스트의 8000 포트가 컨테이너 ai 로 포워딩된다.
BRIDGE_AI_WS_URL=ws://localhost:8000/ai/api/v1/internal/bridge/ws

# AI 서버와 공유하는 인증 토큰. ai/.env 의 HEYGENT_BRIDGE_TOKEN 과 반드시 같아야 한다.
BRIDGE_TOKEN=poc-bridge-shared-token-change-me

# 브릿지가 다룰 사용자 PC 폴더 경계(절대 경로). terminal/file 도구 cwd로 사용.
# 본인 PC 사용자명으로 바꿔주세요. 예: C:\Users\SSAFY\Desktop\poc-workspace
BRIDGE_WORKSPACE_ROOT=C:\Users\YOUR_USER\Desktop\poc-workspace

# heartbeat (WebSocket 프로토콜 레벨 ping). docker NAT 1분 idle 끊김 회피용 핵심 옵션.
BRIDGE_PING_INTERVAL_SECONDS=20

# 연결 끊겼을 때 재연결까지 대기 시간(초).
BRIDGE_RECONNECT_DELAY_SECONDS=3
