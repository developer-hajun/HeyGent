# AI HTTP 서버 설정
HEYGENT_HOST=127.0.0.1
HEYGENT_PORT=8000
HEYGENT_API_PREFIX=/api/v1
HEYGENT_AI_DB_PATH=tmp/app.db
HEYGENT_API_BASE_URL=http://127.0.0.1:8000/api/v1
HEYGENT_CORS_ALLOWED_ORIGINS=http://localhost:5173
HEYGENT_WS_ALLOWED_ORIGINS=http://localhost:5173

# Backend 연동: 사용자 토큰 검증, provider credential 발급, 사용량 기록에 사용합니다.
HEYGENT_BACKEND_BASE_URL=http://127.0.0.1:8080
HEYGENT_BACKEND_AUTH_VERIFY_URL=http://127.0.0.1:8080/internal/ai/auth/validate
HEYGENT_BACKEND_MEMORY_TIMEOUT_SECONDS=5
HEYGENT_INTERNAL_SERVICE_TOKEN=replace-with-backend-internal-token

# OpenAI API 호출 기본값: 실제 API key/OAuth token은 backend provider 연결에서 받아옵니다.
HEYGENT_OPENAI_REST_API_BASE_URL=https://api.openai.com/v1
HEYGENT_OPENAI_RESPONSE_MODEL=gpt-5.4
HEYGENT_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# 로컬 bridge 연동이 필요할 때 사용하는 선택 토큰입니다.
HEYGENT_BRIDGE_TOKEN=

# Agent runtime 제한값
HEYGENT_AGENT_MODEL_REQUEST_TIMEOUT_SECONDS=300
HEYGENT_AGENT_MODEL_STREAM_TIMEOUT_SECONDS=300
HEYGENT_AGENT_LOOP_DEFAULT_MAX_ITERATIONS=90
HEYGENT_AGENT_LOOP_WORKER_DEFAULT_MAX_ITERATIONS=80
HEYGENT_AGENT_LOOP_MAX_ITERATIONS=120

# TaskRun queue/claim 실행: true면 HTTP listener가 직접 실행하지 않고 DB queue에 올립니다.
HEYGENT_TASK_EXECUTION_QUEUE_ENABLED=false
HEYGENT_TASK_EXECUTION_WORKER_COUNT=2
HEYGENT_TASK_EXECUTION_LEASE_SECONDS=300
HEYGENT_TASK_EXECUTION_POLL_INTERVAL_SECONDS=0.5
